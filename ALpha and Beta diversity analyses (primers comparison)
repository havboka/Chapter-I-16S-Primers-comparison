# Helper function to extract genus-level count matrices with unique sample names
get_genus_df <- function(ps_obj, region_label) {
  # Agglomerate to Genus level
  ps_g <- tax_glom(ps_obj, taxrank = "Genus", NArm = FALSE)
  mat <- as(otu_table(ps_g), "matrix")
  if (taxa_are_rows(ps_g)) { mat <- t(mat) }
  
  # Extract genus names
  tax <- as(tax_table(ps_g), "matrix")
  genus_names <- tax[, "Genus"]
  genus_names[is.na(genus_names) | genus_names == ""] <- paste0("Unassigned_", rownames(tax)[is.na(genus_names) | genus_names == ""])
  colnames(mat) <- genus_names
  
  # Format data frame (rows = samples, columns = genera)
  df <- as.data.frame(mat)
  rownames(df) <- paste0(rownames(df), "_", region_label)
  return(df)
}

