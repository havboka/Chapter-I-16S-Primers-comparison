# Helper function to process PCoA data for a given phyloseq object
get_pcoa_df <- function(ps_obj, region_name) {
  # Calculate Bray-Curtis distance and run PCoA
  ord <- ordinate(ps_obj, method = "PCoA", distance = "bray")
  
  # Extract coordinates
  coords <- data.frame(ord$vectors[, 1:2])
  colnames(coords) <- c("PCoA1", "PCoA2")
  coords$Sample_ID <- rownames(coords)
  coords$Region <- region_name
  
  # Extract percentage variance explained
  eig <- ord$values$Eigenvalues
  pct <- round(eig / sum(eig) * 100, 1)
  coords$PC1_pct <- pct[1]
  coords$PC2_pct <- pct[2]
  
  # Assign Mature vs Young SIPL categories
  coords <- coords %>%
    mutate(
      SIPL_Category = case_when(
        grepl("^C03L2|^C04L2", Sample_ID) ~ "Mature SIPL",
        grepl("^C12L2|^C13L2", Sample_ID) ~ "Young SIPL",
        TRUE ~ "Unknown"
      )
    )
  return(coords)
}

