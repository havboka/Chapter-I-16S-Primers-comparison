# PHASE 1: PERCENTAGE OF UNCLASSIFIED RANKS
# ------------------------------------------------------------------------------

library(phyloseq)
library(dplyr)
library(tidyr)

# Put your three phyloseq objects into a named list
primers_list <- list(
  "V3-V4 region" = V3V4.ps,
  "V4 region"    = V4b.ps,
  "V4-V5 region" = V4V5.ps
)

unassigned_patterns <- "^(NA|na|Unknown|unknown|Unclassified|unclassified|uncultured|Ambiguous_taxa|[a-z]__|[a-z]__|)$"

# Calculate assignment percentages for each primer dataset
rank_summary_list <- lapply(names(primers_list), function(p_name) {
  ps <- primers_list[[p_name]]
  tax_df <- as.data.frame(tax_table(ps))
  
  assignment_summary <- sapply(colnames(tax_df), function(rank) {
    col_data <- as.character(tax_df[[rank]])
    
    is_unassigned <- is.na(col_data) | 
      trimws(col_data) == "" | 
      grepl(unassigned_patterns, trimws(col_data), ignore.case = TRUE)
    
    total_asvs <- length(col_data)
    assigned_asvs <- sum(!is_unassigned)
    if(total_asvs == 0) return(0)
    
    round((assigned_asvs / total_asvs) * 100, 2)
  })
  
  data.frame(
    Region = p_name,
    Taxonomic_Rank = names(assignment_summary),
    Percent_Assigned = assignment_summary
  )
})

# Combine and pivot wide for a clean comparative view
combined_rank_summary <- bind_rows(rank_summary_list)
summary_table_wide <- combined_rank_summary %>%
  mutate(Percent_Assigned = paste0(Percent_Assigned, "%")) %>%
  pivot_wider(names_from = Region, values_from = Percent_Assigned)

cat("\n--- TAXONOMIC ASSIGNMENT SUCCESS BY PRIMER REGION ---\n")
print(summary_table_wide)

