# ------------------------------------------------------------------------------
# PHASE 3: Good's coverage
# ------------------------------------------------------------------------------


calculate_goods_coverage <- function(row) {
  N <- sum(row)          # Total reads in sample
  n1 <- sum(row == 1)    # Number of singletons
  if(N == 0) return(NA)
  coverage <- 1 - (n1 / N)
  return(coverage)
}

cat("\n--- GOOD'S COVERAGE SUMMARY BY PRIMER REGION ---\n")
for (p_name in names(primers_list)) {
  ps <- primers_list[[p_name]]
  otu_mat <- as(otu_table(ps), "matrix")
  if (taxa_are_rows(ps)) { otu_mat <- t(otu_mat) }
  
  goods_cov <- apply(otu_mat, 1, calculate_goods_coverage)
  
  cat("\nRegion:", p_name, "\n")
  print(summary(goods_cov))
  
  low_cov <- names(goods_cov[goods_cov < 0.99 & !is.na(goods_cov)])
  if (length(low_cov) > 0) {
    cat("  Samples with < 99% coverage:", paste(low_cov, collapse = ", "), "\n")
  } else {
    cat("  All samples have >= 99% coverage.\n")
  }
}


