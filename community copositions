# 1. Extract detected orders (presence/absence) for each primer set
get_presence_orders <- function(ps_obj) {
  ps_g <- tax_glom(ps_obj, taxrank = "Order", NArm = TRUE)
  tax_tab <- tax_table(ps_g)
  orders <- unique(tax_tab[, "Order"])
  orders <- orders[orders != "" & !is.na(orders)]
  return(orders)
}

