# ==============================================================================
# 2. HELPER FUNCTION TO PREPARE RELATIVE ABUNDANCE DATA (WITH CLEANED LABELS)
# ==============================================================================
prep_composition_data <- function(ps_obj, region_name, tax_rank = "Class", top_n = 12) {
  # Convert counts to relative abundance (percentages)
  ps_rel <- transform_sample_counts(ps_obj, function(x) x / sum(x))
  
  # Melt phyloseq object into a long data frame
  df <- psmelt(ps_rel)
  
  # Remove the '-LJD...' suffix from sample names
  df$Sample <- sub("-LJD.*$", "", df$Sample)
  
  # Clean up unassigned or NA taxonomic names
  df[[tax_rank]] <- as.character(df[[tax_rank]])
  df[[tax_rank]][is.na(df[[tax_rank]]) | df[[tax_rank]] == ""] <- "Unassigned"
  
  # Identify top N most abundant taxa overall to group the rest into "Other"
  top_taxa <- df %>%
    group_by(.data[[tax_rank]]) %>%
    summarise(Mean_Abund = mean(Abundance), .groups = "drop") %>%
    arrange(desc(Mean_Abund)) %>%
    slice_head(n = top_n) %>%
    pull(1)
  
  df <- df %>%
    mutate(
      Taxon_Group = ifelse(.data[[tax_rank]] %in% top_taxa, .data[[tax_rank]], "Other"),
      Region = region_name,
      SIPL_Category = case_when(
        grepl("^C03L2|^C04L2", Sample) ~ "Mature SIPL",
        grepl("^C12L2|^C13L2", Sample) ~ "Young SIPL",
        TRUE ~ "Unknown"
      )
    )
  
  return(df)
}

