library(phyloseq)
library(DESeq2)
library(dplyr)

# 1. Prepare data: Agglomerate to Family level (great for spotting chloroplast/mitochondrial bias)
tax_rank_target <- "Family" # Change to "Genus" if preferred

ps_v3v4_f <- tax_glom(V3V4.ps, tax_rank_target)
ps_v4_f   <- tax_glom(V4b.ps,  tax_rank_target)
ps_v4v5_f <- tax_glom(V4V5.ps, tax_rank_target)

# Add a Region metadata tag to each
sample_data(ps_v3v4_f)$Primer_Region <- "V3-V4"
sample_data(ps_v4_f)$Primer_Region   <- "V4"
sample_data(ps_v4v5_f)$Primer_Region  <- "V4-V5"

# 2. Merge into a single multi-primer phyloseq object at the chosen taxonomic rank
# (Note: we match taxa by taxonomic name string to combine counts across primers)
# Alternatively, run pairwise DESeq2 models between primers. 
# Here is the robust pairwise approach (e.g., V3-V4 vs V4):


# 1. Redefine the helper function to safely assign and lock factor levels internally
run_deseq_primer_comparison <- function(ps1, ps2, name1, name2) {
  # Explicitly assign metadata labels to each phyloseq object
  sample_data(ps1)$Primer_Region <- name1
  sample_data(ps2)$Primer_Region <- name2
  
  # Merge objects and remove zero-sum taxa
  merged_ps <- merge_phyloseq(ps1, ps2)
  merged_ps <- prune_taxa(taxa_sums(merged_ps) > 0, merged_ps)
  
  # Force Primer_Region to be a factor with name1 explicitly set as the first level (reference)
  sample_data(merged_ps)$Primer_Region <- factor(
    as.character(sample_data(merged_ps)$Primer_Region), 
    levels = c(name1, name2)
  )
  
  # Convert to DESeq2 dataset
  diag_dds <- phyloseq_to_deseq2(merged_ps, ~ Primer_Region)
  
  # Run DESeq with zero-inflation safety (poscounts)
  diag_dds <- DESeq(diag_dds, test = "Wald", fitType = "parametric", sfType = "poscounts")
  
  # Extract results
  res <- results(diag_dds, cooksCutoff = FALSE)
  res_df <- as.data.frame(res)
  res_df$Taxon_Name <- tax_table(merged_ps)[rownames(res_df), tax_rank_target]
  res_df$Comparison <- paste0(name2, "_vs_", name1)
  res_df$Taxon_ID <- rownames(res_df)
  
  return(res_df)
}

# 3. Run all three pairwise comparisons
cat("Running Comparison 1: V4 vs V3_V4...\n")
res_v4_vs_v3v4 <- run_deseq_primer_comparison(ps_v3v4_f, ps_v4_f, "V3_V4", "V4")

cat("Running Comparison 2: V4_V5 vs V4...\n")
res_v4v5_vs_v4 <- run_deseq_primer_comparison(ps_v4_f, ps_v4v5_f, "V4", "V4_V5")

cat("Running Comparison 3: V4_V5 vs V3_V4...\n")
res_v4v5_vs_v3v4 <- run_deseq_primer_comparison(ps_v3v4_f, ps_v4v5_f, "V3_V4", "V4_V5")

# 4. Combine everything into a single master results table
all_comparisons <- bind_rows(res_v4_vs_v3v4, res_v4v5_vs_v4, res_v4v5_vs_v3v4)

# 5. Filter for significantly enriched/depleted taxa (padj < 0.05)
sig_results <- all_comparisons %>% 
  filter(padj < 0.05) %>% 
  arrange(Comparison, desc(log2FoldChange))

cat("\n--- Top Significant Differential Taxa Across All Comparisons ---\n")
print(head(sig_results, 15))

# 6. Save master table for your thesis chapter
write.csv(all_comparisons, "DESeq2_All_Primer_Pairwise_Comparisons.csv", row.names = FALSE)
write.csv(sig_results, "DESeq2_Significant_Taxa_Only.csv", row.names = FALSE)




