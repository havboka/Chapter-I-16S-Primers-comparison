# 1. Load the merged, chimera-free ASV table
V3V4.seqtab.nochim <- readRDS("/mnt/data/home/salvatorecampanile/primers attempt/V3-V4/V3-V4-seqtab.nochim.rds") 

# 2. Load sample metadata safely (forcing the 1st column as row names)
V3V4.metadata <- read.csv("/mnt/data/home/salvatorecampanile/primers attempt/V3-V4/V3-V4 metadata.csv", header = TRUE, stringsAsFactors = FALSE)
rownames(V3V4.metadata) <- trimws(V3V4.metadata[, 1])

# 3. Run taxonomic assignment with 8 ranks
V3V4.taxonomy <- assignTaxonomy(
  V3V4.seqtab.nochim,
  "/mnt/data/home/salvatorecampanile/Paper 1 final results and plots/paper 1 results/silva_nr99_v144_toSpecies_trainset.fa.gz",
  multithread = TRUE,
  tryRC = TRUE,
  taxLevels = c("Domain", "Kingdom", "Phylum", "Class", "Order", "Family", "Genus", "Species")
)

cat("Total ASVs in sequence table:", ncol(V3V4.seqtab.nochim), "\n") #check content of each
cat("Total ASVs in taxonomy table:", nrow(V3V4.taxonomy), "\n") 
cat("Total metadata samples loaded:", nrow(V3V4.metadata), "\n")

# 4. Combine your tables into a single phyloseq object
V3V4.ps <- phyloseq(
  otu_table(V3V4.seqtab.nochim, taxa_are_rows = FALSE),
  tax_table(V3V4.taxonomy),
  sample_data(V3V4.metadata)
)

# ---------------------------------------------------------------------
# STEP 2: CONTAMINANT REMOVAL USING DECONTAM (PREVALENCE METHOD)
# ---------------------------------------------------------------------

# Identify actual extraction blanks in the phyloseq object
sample_data(V3V4.ps)$is.neg <-
  grepl("NEG-V3V4", sample_names(V3V4.ps))

cat("\nNegative controls identified:\n")
print(table(sample_data(V3V4.ps)$is.neg))

cat("\nNegative control samples:\n")
print(sample_names(V3V4.ps)[sample_data(V3V4.ps)$is.neg])

# 2. Identify contaminants using prevalence method
V3V4.contam.df <- isContaminant(
  V3V4.ps,
  method = "prevalence",
  neg = "is.neg"
)

cat("\n--- DECONTAM RESULTS ---\n")
cat("Number of contaminant ASVs:", sum(V3V4.contam.df$contaminant), "\n")
cat("Number of non-contaminant ASVs:", sum(!V3V4.contam.df$contaminant), "\n")

# 3. Remove contaminants and blanks if present
V3V4_clean <- prune_taxa(!V3V4.contam.df$contaminant, V3V4.ps)
V3V4_clean <- prune_samples(!sample_data(V3V4_clean)$is.neg, V3V4_clean)


# 6. Save cleaned dataset
setwd("/mnt/data/home/salvatorecampanile/chapter I: primers comparison for chloroplast contamination")
saveRDS(V3V4_clean, file = "V3V4_no_contaminants.rds")






