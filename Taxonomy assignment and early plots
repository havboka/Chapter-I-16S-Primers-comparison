# Helper function to safely sum reads for a category (prevents crashes if a category has 0 ASVs)
get_category_percentage <- function(otu_mat, tax_df, cat_name, total_reads) {
  matching_cols <- which(tax_df$Category == cat_name)
  if (length(matching_cols) == 0) {
    return(rep(0, nrow(otu_mat)))
  }
  sub_mat <- otu_mat[, matching_cols, drop = FALSE]
  100 * base::rowSums(sub_mat, na.rm = TRUE) / total_reads
}


