# 1. Load your three clean phyloseq objects
V3V4.ps <- readRDS("/mnt/data/home/salvatorecampanile/chapter I: primers comparison for chloroplast contamination/V3V4_no_contaminants.rds")
V4b.ps  <- readRDS("/mnt/data/home/salvatorecampanile/chapter I: primers comparison for chloroplast contamination/V4b_no_contaminants.rds")
V4V5.ps <- readRDS("/mnt/data/home/salvatorecampanile/chapter I: primers comparison for chloroplast contamination/V4V5_no_contaminants.rds")

# Helper function to safely get absolute read sums for a category
get_category_reads <- function(otu_mat, tax_df, cat_name) {
  matching_cols <- which(tax_df$Category == cat_name)
  if (length(matching_cols) == 0) {
    return(rep(0, nrow(otu_mat)))
  }
  sub_mat <- otu_mat[, matching_cols, drop = FALSE]
  base::rowSums(sub_mat, na.rm = TRUE)
}

# Function to process each phyloseq object and extract a unified BioSample key
process_ps <- function(ps_obj, region_name) {
  otu <- as.matrix(otu_table(ps_obj))
  if (taxa_are_rows(ps_obj)) { otu <- t(otu) }
  tax <- as.data.frame(tax_table(ps_obj))
  tax$ASV <- rownames(tax)
  tax <- tax[match(colnames(otu), tax$ASV), ]
  
  cat <- rep("Other", nrow(tax))
  cat[apply(tax, 1, function(x) any(grepl("Eukaryota", x, ignore.case = TRUE)))] <- "Eukaryota"
  cat[apply(tax, 1, function(x) any(grepl("Chloroplast", x, ignore.case = TRUE)))] <- "Chloroplast"
  cat[apply(tax, 1, function(x) any(grepl("Mitochondria", x, ignore.case = TRUE)))] <- "Mitochondria"
  cat[(tax$Domain %in% c("Bacteria", "Archaea")) & cat == "Other"] <- "Prokaryotes"
  tax$Category <- cat
  
  df <- data.frame(
    Sample       = rownames(otu),
    Prokaryotes  = get_category_reads(otu, tax, "Prokaryotes"),
    Eukaryota    = get_category_reads(otu, tax, "Eukaryota"),
    Chloroplast  = get_category_reads(otu, tax, "Chloroplast"),
    Mitochondria = get_category_reads(otu, tax, "Mitochondria"),
    Region       = region_name,
    stringsAsFactors = FALSE
  )
  
  clean_names <- sub("-(.*)$", "", df$Sample)
  df$BioSample <- gsub("V4V5|V3V4|V4", "", clean_names)
  
  return(df)
}

# --- 2. PROCESS ALL THREE DATASETS ---
df_v3v4 <- process_ps(V3V4.ps, "V3-V4 region")
df_v4b  <- process_ps(V4b.ps,  "V4 region")
df_v4v5 <- process_ps(V4V5.ps, "V4-V5 region")

# --- 3. COMBINE, PIVOT, AND COMPLETE GRID FOR ALLUVIALS ---
combined_data <- bind_rows(df_v3v4, df_v4b, df_v4v5)

plot_data <- combined_data %>%
  pivot_longer(
    cols = c(Prokaryotes, Eukaryota, Chloroplast, Mitochondria),
    names_to = "Category", 
    values_to = "ReadCount"
  )

# Ensure every BioSample has every Region and Category represented
plot_data <- plot_data %>%
  complete(BioSample, Region, Category, fill = list(ReadCount = 0))

plot_data$Category <- factor(plot_data$Category, levels = c("Prokaryotes", "Eukaryota", "Chloroplast", "Mitochondria"))
plot_data$Region <- factor(plot_data$Region, levels = c("V3-V4 region", "V4 region", "V4-V5 region"))

# --- 4. BUILD HORIZONTAL CONNECTED ALLUVIAL PLOT ---
p_alluvial_combined <- ggplot(plot_data, aes(x = Region, y = ReadCount, stratum = Category, alluvium = interaction(BioSample, Category), fill = Category)) +
  geom_flow(alpha = 0.2, color = NA) +          # Light, transparent streams connecting categories
  geom_stratum(width = 0.6, color = "black") +  # Solid stacked absolute abundance bars at each region
  facet_wrap(~ BioSample, scales = "free_x", ncol = 2) + # Side-by-side faceted comparison per biological sample
  scale_y_continuous(labels = scales::comma, expand = c(0, 0), limits = c(0, NA)) +
  scale_fill_manual(values = c(
    "Prokaryotes" = "#2166AC", 
    "Eukaryota" = "#F4A582", 
    "Chloroplast" = "#66BD63", 
    "Mitochondria" = "#9E9AC8"
  )) +
  coord_flip() + # Flips axes to make the plot horizontal
  labs(x = NULL, y = "Absolute number of reads", fill = NULL) +
  theme_classic() +
  theme(
    strip.background = element_rect(fill = "grey90", colour = NA),
    strip.text = element_text(face = "bold", size = 11),
    legend.position = "bottom",
    legend.text = element_text(size = 12),
    legend.key.size = unit(0.8, "cm")
  )

print(p_alluvial_combined)
